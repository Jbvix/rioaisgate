PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/rioaisgate
# Backup local: npm run backup (usa DATABASE_URL ou DATABASE_PRIVATE_URL)
# Retenção automática no Postgres (job diário no backend)
EVENT_RETENTION_DAYS=7
POSITION_RETENTION_HOURS=6
# RETENTION_INTERVAL_MS=86400000
# Railway: vincule o Postgres ao backend — use a referência DATABASE_PRIVATE_URL (rede interna).
# DATABASE_PRIVATE_URL é preferida automaticamente quando existir.
AISSTREAM_API_KEY=your_aisstream_api_key_here
FRONTEND_URL=http://localhost:5173,https://seu-app.netlify.app
# Slug do site Netlify: habilita previews https://{deploy-id}--{slug}.netlify.app no CORS/WebSocket
NETLIFY_SITE_SLUG=riogateais
AIS_FEED_TIMEZONE=America/Sao_Paulo
# Horários iguais (ex. 0 e 0) = AIS 24h. Ex. janela comercial: START=8 END=18
AIS_FEED_START_HOUR=0
AIS_FEED_END_HOUR=0
LOG_LEVEL=info
# Pool Postgres (Railway: use DATABASE_PRIVATE_URL + PG_POOL_MAX=20)
PG_POOL_MAX=20
# Trilhas brutas vessel_positions — desligado por padrão (mapa/eventos não usam). Backup mensal: npm run backup
AIS_SAVE_POSITIONS=false
AIS_POSITION_FLUSH_MS=30000
AIS_UPSERT_FLUSH_MS=5000
AIS_POSITION_BATCH_SIZE=40
# Só se AIS_SAVE_POSITIONS=true: 1 gravação / N min por navio; sem gravação nos primeiros 2 min após start
AIS_POSITION_PERSIST_MINUTES=15
AIS_POSITION_PERSIST_WARMUP_MS=120000
POSITION_MAX_ROWS=8000
POSITION_PRUNE_INTERVAL_MS=1800000
RETENTION_INTERVAL_MS=21600000
# Geofence — evita rajada de ENTRY/EXIT na boca da barra (jitter GPS / restart)
GEOFENCE_CONFIRM_READS=2
GEOFENCE_EVENT_COOLDOWN_MS=120000
GEOFENCE_WARMUP_MS=120000
# Telegram — alertas ENTRY/EXIT (Sprint 1 broadcast + Sprint 2 /watch)
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Broadcast: todos os eventos para estes chats (TELEGRAM_BROADCAST=false = só assinaturas /watch)
TELEGRAM_BROADCAST=true
TELEGRAM_CHAT_IDS=
TELEGRAM_BOT_POLLING=true
